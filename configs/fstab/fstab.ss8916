#

# Boot
/dev/null /boot emmc defaults defaults

# DSP
/dev/block/by-name/dsp /vendor/dsp ext4 ro,nosuid,nodev defaults

# Firmware
/dev/block/by-name/apnhlos /vendor/firmware_mnt vfat ro,context=u:object_r:firmware_mnt_file:s0,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337 defaults
/dev/block/by-name/modem /vendor/firmware-modem vfat ro,context=u:object_r:firmware_mnt_file:s0,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337 defaults

# FRP
/dev/block/by-name/config /frp emmc defaults defaults

# Persist
/dev/block/by-name/persist /mnt/vendor/persist ext4 nosuid,nodev,noatime,ro defaults

# Recovery
/dev/null /recovery emmc defaults defaults

# SDcard
/devices/platform/soc@0/7864900.mmc/mmc_host/mmc* auto auto defaults voldmanaged=sdcard:auto,encryptable=userdata,noemulatedsd

# USB
/devices/platform/soc@0/78db000.usb/*/usb* auto auto defaults voldmanaged=usb:auto,noemulatedsd

# ZRAM
/dev/block/zram0 none swap defaults zramsize=50%
